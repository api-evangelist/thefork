                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"<uuid>\",\n  \"createdAt\": \"<dateTime>\",\n  \"reservationStatus\": \"REQUESTED\",\n  \"partySize\": \"<integer>\",\n  \"startTime\": \"<dateTime>\",\n  \"customer\": {\n    \"id\": \"<string>\",\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\",\n    \"allergies\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"dietaryRestrictions\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"prepayment\": {\n    \"amount\": \"<integer>\",\n    \"currency\": \"<string>\"\n  },\n  \"offer\": {\n    \"type\": \"<string>\",\n    \"name\": \"<string>\",\n    \"discount\": \"<number>\",\n    \"price\": \"<integer>\"\n  },\n  \"tables\": [\n    {\n      \"name\": \"<string>\",\n      \"areaName\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"areaName\": \"<string>\"\n    }\n  ]\n}",
