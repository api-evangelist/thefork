          "name": "Close Order",
          "request": {
            "name": "Close Order",
            "description": {
              "content": "Close an order on payment and send the final order details (total amount and currency) back to TheFork so the reservation can be marked LEFT.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orders",
                ":orderId",
                "close"
              ],
              "host": [
                "{{baseUrl}}"
              ],
